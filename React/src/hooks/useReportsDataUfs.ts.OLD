type UfChartProps = {
    data: {year: string, data: { uf: string, totaç_expanses: number}[]}[]
};



const fetchData = async ()  => {
  const  res = await fetch(`https://apis.codante.io/senator-expenses/summary/by-uf`);
  const data = await res.json();
  console.log(data[0]);
  console.log("Ufs",data)
  return data
}


export function useReportsDataUfs(){
    const query = useQuery<UfChartProps>({
      queryFn: fetchData,
      queryKey: ['get-reports-ufs'],
      refetchInterval: 60 * 5 * 1000
    })

    return query;
}
